# Google social login — copy into the API's .env (never commit real values).
#
# The secret is only ever read by the API (see google-oauth.service.ts); the
# browser sees the client id alone. Rotate the secret in Google Cloud if it is
# ever pasted into a chat, ticket, or screenshot.
GOOGLE_CLIENT_ID=773972750372-8hamr2cer3juf6qbh53q8aivmc8v0om9.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-a-freshly-rotated-secret

# Comma-separated allowlist; must match "Authorized redirect URIs" in Google Cloud.
GOOGLE_REDIRECT_URIS=http://localhost:8081/auth/callback,https://development.3elagi.net/auth/callback

# Native client ids — an Expo build signs in with these, so their tokens carry
# them as `aud`. Leave blank if a platform is not shipped yet; blanks are
# ignored rather than treated as a valid audience.
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_ID_ANDROID=
# Optional: only if the app's web client id differs from GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID_WEB=

# Native Expo client id (matches EXPO_PUBLIC_GOOGLE_CLIENT_MOBILE_ID).
GOOGLE_CLIENT_MOBILE_ID=
# Same value — Cloud Run currently uses this env var name.
GOOGLE_MOBILE_CLIENT_ID=
